# .env.example — established by dz-runner setup mode.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.
# Loaded by `bin/setup` and `bin/dev` (set -a) whenever `.env` exists — `uv run`
# does not read it on its own, and nothing can export into your interactive
# shell: for MCP servers your editor starts from `.mcp.json`, source it first:
#   set -a; . ./.env; set +a

# device.py in both projects reads it to force cpu|cuda|auto; default applies when unset (optional)
RESEARCH_DEVICE=

# consumed by the sentry MCP server in .mcp.json (optional)
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=

# consumed by the developerz MCP server in .mcp.json (optional)
DEVELOPERZ_API_KEY=
