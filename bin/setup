#!/usr/bin/env bash
# one-command setup — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v mise >/dev/null && mise install
(dpkg -s curl ca-certificates git >/dev/null 2>&1 || (sudo -n apt-get update && sudo -n apt-get install -y --no-install-recommends curl ca-certificates git)) && curl -LsSf https://astral.sh/uv/install.sh | sh && export PATH="$HOME/.local/bin:$PATH" && uv sync --extra dev --project projects/001-geometric-reasoning && uv sync --extra dev --project projects/002-ftl-axiom-search
