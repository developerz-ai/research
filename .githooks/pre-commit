#!/usr/bin/env bash
# pre-commit gate — established by dz-runner setup mode. Runs the SAME
# `bin/check` CI runs, so a commit that would fail CI fails here first.
# ACTIVATE IT (once, per clone): git config core.hooksPath .githooks
# bin/setup runs that for you; bin/check asserts the hook is mode 100755 in git.
set -euo pipefail
cd "$(dirname "$0")/.."
exec bin/check
